# ⚔️ FACE-OFF — Production Environment Variables

# Next.js App URL
NEXT_PUBLIC_APP_URL=https://faceoff-arena.vercel.app

# Supabase Production Backend
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Content Moderation API (Optional Cloud Vision / AWS Rekognition Key)
MODERATION_API_KEY=your-cloud-vision-api-key
